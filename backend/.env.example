# ══════════════════════════════════════════════════════════════════════════════
# Suvidha Clinic Management System — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Suvidha Clinic"
APP_ENV=development                         # development | staging | production
APP_VERSION=1.0.0
DEBUG=true                                  # Set false in production

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_secret
POSTGRES_DB=clinic_db
POSTGRES_HOST=db                            # service name in docker-compose
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_secret@db:5432/clinic_db
SYNC_DATABASE_URL=postgresql://clinic_user:clinic_secret@db:5432/clinic_db

# ── Redis & Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose: groq | gemini | ollama
AI_PROVIDER=groq

# Groq (Free tier: 14,400 requests/day) — get key at console.groq.com
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Free tier: 1M tokens/day) — get key at aistudio.google.com
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY
GEMINI_MODEL=gemini-1.5-flash

# Ollama (Self-hosted, completely free)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Stripe Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_KEY
STRIPE_CURRENCY=inr

# ── File Storage ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local                       # local | s3
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=20

# AWS S3 (only required if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=clinic-reports

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clinic@example.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@clinic.com
FROM_NAME="Suvidha Clinic"

# ── SMS (Twilio or Fast2SMS) ─────────────────────────────────────────────────
SMS_PROVIDER=fast2sms                       # twilio | fast2sms
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── WhatsApp (360Dialog / WATI / Meta Cloud API) ─────────────────────────────
WHATSAPP_PROVIDER=meta                      # meta | wati | 360dialog
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                              # true in production for log aggregators

# ── Appointment Reminders (Celery Beat schedule) ─────────────────────────────
REMINDER_HOURS_BEFORE=24                    # Send reminder 24h before appointment
